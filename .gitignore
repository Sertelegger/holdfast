/target
**/*.rs.bk

# The test log scripts/ci-skip-census.sh reads. CI writes it in the `test`
# job, and the script's own header tells a developer to write it here too,
# so it is exactly the kind of file an `git add -A` sweeps up.
/test-output.log

# Scratch test binaries. `zz_` is the established convention here for a
# throwaway harness -- a race hammer, a trace probe, a leak reproduction --
# and three have now had to be cleaned up by hand after the fact. Cargo
# collects anything in `tests/`, so one left behind runs in CI; ignoring
# them means a stray cannot be swept into a commit by `git add -A`, while
# still running locally for whoever wrote it.
crates/*/tests/zz_*.rs

# graphify knowledge graph (generated; rebuilt by the post-commit hook)
graphify-out/

# SDD working artifacts — ledgers, task briefs, reports, review packages.
# `.superpowers/sdd/.gitignore` already self-ignores with `*`, but that only
# covers what lands under `sdd/`; this covers the directory itself so a new
# artifact elsewhere in it cannot become tracked by an `git add -A`.
.superpowers/

# Design specification and implementation plans. Deliberately local-only:
# working documents rather than published artifacts, and not part of what a
# consumer of this repository needs. Kept on the author's machine and
# stripped from history rather than merely untracked, so they are absent from
# the remote entirely.
docs/

# Python bytecode from the checks in scripts/. Untracked and swept up by an
# `git add -A` exactly like the zz_ scratch tests were, and for the same
# reason: the convention is fine, depending on everyone remembering to clean
# up is not.
__pycache__/
*.pyc

# direnv: local environment, may hold credentials — never commit
.envrc
.envrc.local
