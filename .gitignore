/target
**/*.rs.bk

# graphify knowledge graph (generated; rebuilt by the post-commit hook)
graphify-out/

# SDD working artifacts — ledgers, task briefs, reports, review packages.
# `.superpowers/sdd/.gitignore` already self-ignores with `*`, but that only
# covers what lands under `sdd/`; this covers the directory itself so a new
# artifact elsewhere in it cannot become tracked by an `git add -A`.
.superpowers/

# Design specification and implementation plans. Deliberately local-only:
# working documents rather than published artifacts, and not part of what a
# consumer of this repository needs. Kept on the author's machine and
# stripped from history rather than merely untracked, so they are absent from
# the remote entirely.
docs/
