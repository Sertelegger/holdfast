# holdfast wire shape — protocol 1.1
#
# Generated from the encoded bytes of the live types by
# crates/holdfast-core/tests/wire_shape.rs. Read that file before
# editing this one: a version already recorded here is a promise to
# every peer built against it, and rewriting a row in place is the
# thing the guard exists to make visible (GH #18).
#
#   declared: the fields the type has, including any the encoder skips
#   wire:     the CBOR actually emitted, keys sorted
#   variants: serde's own list, generated by the derive

[framing]
LENGTH_PREFIX_BYTES = 4
MAX_FRAME_BYTES = 16777216

[tokens]
METHOD_DAEMON_STATUS = "daemon/status"
METHOD_DAEMON_STOP = "daemon/stop"
METHOD_HANDSHAKE = "holdfast/handshake"
METHOD_RESOURCE_LIST = "resource/list"
METHOD_RESOURCE_READ = "resource/read"
METHOD_RESOURCE_TEMPLATES_LIST = "resource/templates_list"
REJECT_CLIENT_TOO_NEW = "client_protocol_too_new"
REJECT_CLIENT_TOO_OLD = "client_protocol_too_old"
TOOL_METHOD_PREFIX = "tool/"

[error-codes] (ordered — §18.3 row order)
unknown_method
bad_params
frame_too_large
no_handshake
protocol_violation
limit_reached
daemon_shutting_down

[vocabularies]
ClientKind: shim, cli, ui-bridge
AttachMode: ReadWrite, ReadOnly
AttachRole: interactive, observer
SignalName: int, term, kill
ApprovalDecision: approve, deny

[control]
Request
  declared: id, method, params
  wire:     {id: int, method: "<str>", params: {}}
Response
  declared: data, details, id, status
  wire:     {data: {}, details: "<str>", id: int, status: "<str>"}
ControlError
  declared: code, message, retriable, rpc_code
  wire:     {code: "<str>", message: "<str>", retriable: bool, rpc_code: int}
HandshakeParams
  declared: client_kind, client_version, protocol_major, protocol_minor
  wire:     {client_kind: "shim", client_version: "<str>", protocol_major: int, protocol_minor: int}
HandshakeData
  declared: accepted, build, daemon_version, protocol_major, protocol_minor, reject_reason
  wire:     {accepted: bool, build: "<str>", daemon_version: "<str>", protocol_major: int, protocol_minor: int, reject_reason: "<str>"}
DaemonStatus
  declared: attach_clients, bridge_sessions, pid, sessions_exited_retained, sessions_live, uptime_secs, version
  wire:     {attach_clients: int, bridge_sessions: int, pid: int, sessions_exited_retained: int, sessions_live: int, uptime_secs: int, version: "<str>"}
StopParams
  declared: force, timeout_secs
  wire:     {force: bool, timeout_secs: int}
StopOutcome
  declared: sessions_terminated, stopped_at_unix_secs
  wire:     {sessions_terminated: int, stopped_at_unix_secs: int}

[attach.client]
variants: Attach, Input, SecretInput, Resize, Signal, ApproveBinding, Detach
ClientFrame::Attach
  declared: client_kind, client_version, mode, protocol_major, protocol_minor, role, session, terminal
  wire:     {client_kind: "shim", client_version: "<str>", mode: "ReadWrite", protocol_major: int, protocol_minor: int, role: "interactive", session: "<str>", terminal: "<str>", type: "Attach"}
ClientFrame::Input
  declared: bytes
  wire:     {bytes: bytes, type: "Input"}
ClientFrame::SecretInput
  declared: bytes, request_id
  wire:     {bytes: bytes, request_id: "<str>", type: "SecretInput"}
ClientFrame::Resize
  declared: cols, rows
  wire:     {cols: int, rows: int, type: "Resize"}
ClientFrame::Signal
  declared: sig
  wire:     {sig: "int", type: "Signal"}
ClientFrame::ApproveBinding
  declared: approval_id, decision
  wire:     {approval_id: "<str>", decision: "approve", type: "ApproveBinding"}
ClientFrame::Detach
  declared: (none)
  wire:     {type: "Detach"}

[attach.server]
variants: Attached, AttachReject, Output, SessionExited, Resize, AwaitingSecret, SecretRequestClosed, BindingApprovalRequired, ProtocolError, Detached
ServerFrame::Attached
  declared: cols, exit_code, name, protocol_major, protocol_minor, rows, session_id, state
  wire:     {cols: int, exit_code: int, name: "<str>", protocol_major: int, protocol_minor: int, rows: int, session_id: "<str>", state: "<str>", type: "Attached"}
ServerFrame::AttachReject
  declared: message, reason
  wire:     {message: "<str>", reason: "<str>", type: "AttachReject"}
ServerFrame::Output
  declared: bytes, session
  wire:     {bytes: bytes, session: "<str>", type: "Output"}
ServerFrame::SessionExited
  declared: code
  wire:     {code: int, type: "SessionExited"}
ServerFrame::Resize
  declared: cols, rows
  wire:     {cols: int, rows: int, type: "Resize"}
ServerFrame::AwaitingSecret
  declared: prompt_text, request_id
  wire:     {prompt_text: "<str>", request_id: "<str>", type: "AwaitingSecret"}
ServerFrame::SecretRequestClosed
  declared: outcome, request_id
  wire:     {outcome: "<str>", request_id: "<str>", type: "SecretRequestClosed"}
ServerFrame::BindingApprovalRequired
  declared: approval_id, binding_name, command_line, prompt_text, provider, session
  wire:     {approval_id: "<str>", binding_name: "<str>", command_line: "<str>", prompt_text: "<str>", provider: "<str>", session: "<str>", type: "BindingApprovalRequired"}
ServerFrame::ProtocolError
  declared: frame_kind, reason
  wire:     {frame_kind: "<str>", reason: "<str>", type: "ProtocolError"}
ServerFrame::Detached
  declared: reason
  wire:     {reason: "<str>", type: "Detached"}
